import tkinter as tk
from tkinter import ttk, messagebox
import numpy as np
import pandas as pd

from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline

from sklearn.neural_network import MLPRegressor
from sklearn.svm import SVR
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor

from xgboost import XGBRegressor
from lightgbm import LGBMRegressor

from bayes_opt import BayesianOptimization

# ===================== FILE PATH =====================
DATASET_PATH = r"D:\Madhav_Krishna\ML\ML.xlsx"

# ===================== MODELS =====================
def get_models():
    return {
        "ANN": MLPRegressor(max_iter=2000),
        "SVR": SVR(),
        "DT": DecisionTreeRegressor(),
        "RF": RandomForestRegressor(),
        "XGB": XGBRegressor(objective="reg:squarederror", verbosity=0),
        "LGB": LGBMRegressor()
    }

# ===================== BAYESIAN OPT =====================
def bayesian_opt(model_name, X, y):
    def objective(**params):
        model = None

        if model_name == "SVR":
            model = SVR(C=params["C"], gamma=params["gamma"])
        elif model_name == "DT":
            model = DecisionTreeRegressor(max_depth=int(params["max_depth"]))
        elif model_name == "RF":
            model = RandomForestRegressor(
                n_estimators=int(params["n_estimators"]),
                max_depth=int(params["max_depth"])
            )
        elif model_name == "XGB":
            model = XGBRegressor(
                n_estimators=int(params["n_estimators"]),
                max_depth=int(params["max_depth"]),
                learning_rate=params["learning_rate"],
                objective="reg:squarederror",
                verbosity=0
            )
        elif model_name == "LGB":
            model = LGBMRegressor(
                n_estimators=int(params["n_estimators"]),
                max_depth=int(params["max_depth"]),
                learning_rate=params["learning_rate"]
            )
        elif model_name == "ANN":
            model = MLPRegressor(
                hidden_layer_sizes=(int(params["neurons"]),),
                alpha=params["alpha"],
                max_iter=2000
            )

        pipe = Pipeline([
            ("scaler", StandardScaler()),
            ("model", model)
        ])

        score = cross_val_score(pipe, X, y, cv=5, scoring="r2").mean()
        return score

    bounds = {
        "SVR": {"C": (1, 200), "gamma": (0.0001, 1)},
        "DT": {"max_depth": (2, 20)},
        "RF": {"n_estimators": (50, 300), "max_depth": (3, 20)},
        "XGB": {"n_estimators": (50, 300), "max_depth": (3, 10), "learning_rate": (0.01, 0.3)},
        "LGB": {"n_estimators": (50, 300), "max_depth": (3, 15), "learning_rate": (0.01, 0.3)},
        "ANN": {"neurons": (10, 200), "alpha": (0.0001, 0.1)}
    }

    optimizer = BayesianOptimization(
        f=objective,
        pbounds=bounds[model_name],
        random_state=42,
        verbose=0
    )

    optimizer.maximize(init_points=5, n_iter=25)
    return optimizer.max["params"]

# ===================== TRAIN & PREDICT =====================
def train_predict(X, y, input_data, tune):
    results = {}
    best_model = None
    best_pred = -np.inf

    for name, model in get_models().items():

        if tune:
            params = bayesian_opt(name, X, y)

            if name == "SVR":
                model = SVR(**params)
            elif name == "DT":
                model = DecisionTreeRegressor(max_depth=int(params["max_depth"]))
            elif name == "RF":
                model = RandomForestRegressor(
                    n_estimators=int(params["n_estimators"]),
                    max_depth=int(params["max_depth"])
                )
            elif name == "XGB":
                model = XGBRegressor(
                    n_estimators=int(params["n_estimators"]),
                    max_depth=int(params["max_depth"]),
                    learning_rate=params["learning_rate"],
                    objective="reg:squarederror",
                    verbosity=0
                )
            elif name == "LGB":
                model = LGBMRegressor(
                    n_estimators=int(params["n_estimators"]),
                    max_depth=int(params["max_depth"]),
                    learning_rate=params["learning_rate"]
                )
            elif name == "ANN":
                model = MLPRegressor(
                    hidden_layer_sizes=(int(params["neurons"]),),
                    alpha=params["alpha"],
                    max_iter=2000
                )

        pipe = Pipeline([
            ("scaler", StandardScaler()),
            ("model", model)
        ])

        pipe.fit(X, y)
        pred = pipe.predict([input_data])[0]

        results[name] = pred

        if pred > best_pred:
            best_pred = pred
            best_model = name

    return results, best_model

# ===================== GUI =====================
class GFRC_GUI:
    def __init__(self, root, target):
        self.target = target
        root.title(f"{target} Predictor (Bayesian Optimization)")

        self.entries = {}
        inputs = ["Cement", "F", "M", "CA", "FA", "RCA", "Water", "SP", "GF", "Age"]

        for i, inp in enumerate(inputs):
            ttk.Label(root, text=inp).grid(row=i, column=0)
            e = ttk.Entry(root)
            e.grid(row=i, column=1)
            self.entries[inp] = e

        self.mode = tk.BooleanVar()
        ttk.Checkbutton(root, text="Tune (Bayesian Optimization)", variable=self.mode).grid(row=11, column=0, columnspan=2)

        ttk.Button(root, text="Predict", command=self.predict).grid(row=12, column=0)
        ttk.Button(root, text="Exit", command=root.destroy).grid(row=12, column=1)

        self.log = tk.Text(root, width=60, height=20)
        self.log.grid(row=0, column=2, rowspan=13)

    def predict(self):
        df = pd.read_excel(DATASET_PATH)

        X = df[["Cement","F","M","CA","FA","RCA","Water","SP","GF","Age"]]
        y = df[self.target]

        input_data = [float(self.entries[k].get()) for k in self.entries]

        self.log.insert(tk.END, "Training models...\n")

        results, best = train_predict(X, y, input_data, self.mode.get())

        for k, v in results.items():
            self.log.insert(tk.END, f"{k}: {v:.4f} MPa\n")

        self.log.insert(tk.END, f"\nSelected Best Model: {best}\n")

# ===================== RUN =====================
if __name__ == "__main__":
    root = tk.Tk()
    GFRC_GUI(root, target="CS")   # Change to STS or FS
    root.mainloop()

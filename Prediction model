def clean_series_to_numeric(s: pd.Series):
    """Clean a pandas Series containing numeric-like strings and convert to numeric."""
    s_str = s.astype(str).fillna("")
    cleaned = s_str.str.replace(r"[^0-9eE\+\-\.]", "", regex=True)
    cleaned = cleaned.replace("", np.nan)
    numeric = pd.to_numeric(cleaned, errors="coerce")
    return numeric


def build_pipelines(random_state=42):
    """Return simple pipelines (scaler + estimator)"""
    pipes = {
        "MLP": Pipeline([("scaler", StandardScaler()), ("est", MLPRegressor(max_iter=400, random_state=random_state))]),
        "DT": Pipeline([("scaler", StandardScaler()), ("est", DecisionTreeRegressor(random_state=random_state))]),
        "SVR": Pipeline([("scaler", StandardScaler()), ("est", SVR())]),
        "RF": Pipeline([("scaler", StandardScaler()), ("est", RandomForestRegressor(random_state=random_state))]),
        "XGB": Pipeline([("scaler", StandardScaler()), ("est", XGBRegressor(objective='reg:squarederror', random_state=random_state, verbosity=0))]),
        "LGB": Pipeline([("scaler", StandardScaler()), ("est", LGBMRegressor(random_state=random_state))]),
    }
    return pipes



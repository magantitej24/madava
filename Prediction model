    def log_write(self, text: str):
        self.log.insert("end", f"{text}\n")
        self.log.see("end")

    def _update_range_labels(self):
        """Update the [min - max] labels for each feature based on self.df, but show preset if given."""
        for feat in FEATURES:
            # use preset if available
            if feat in PRESET_RANGES:
                mn, mx = PRESET_RANGES[feat]
                range_text = f"[{mn} - {mx}]"
            else:
                if self.df is None or feat not in self.df.columns:
                    range_text = "[ - ]"
                else:
                    mn = self.df[feat].min()
                    mx = self.df[feat].max()
                    def fmt(x):
                        if pd.isna(x):
                            return "-"
                        if float(x).is_integer():
                            return f"{int(x)}"
                        return f"{round(float(x), 3)}"
                    range_text = f"[{fmt(mn)} - {fmt(mx)}]"
            self.range_labels[feat].config(text=range_text)

    def load_excel(self):
        """Load and clean the Excel file (auto) and update range labels."""
        try:
            df = pd.read_excel(FILE_PATH)
        except FileNotFoundError:
            self.log_write(f"Excel file not found: {FILE_PATH}")
            messagebox.showwarning("File not found", f"Could not find: {FILE_PATH}")
            self.df = None
            self._update_range_labels()
            return
        except Exception as e:
            self.log_write(f"Error reading Excel: {e}")
            messagebox.showerror("Error", f"Could not read Excel: {e}")
            self.df = None
            self._update_range_labels()
            return

        required = set(FEATURES + [TARGET])
        missing = [c for c in required if c not in df.columns]
        if missing:
            self.log_write(f"Missing required columns: {missing}")
            messagebox.showerror("Missing columns", f"Please ensure sheet has: {sorted(list(required))}")
            self.df = None
            self._update_range_labels()
            return

        n_before = len(df)
        for col in list(FEATURES) + [TARGET]:
            self.log_write(f"Cleaning column: {col}")
            df[col] = clean_series_to_numeric(df[col])
        df_clean = df.dropna(subset=list(FEATURES) + [TARGET]).reset_index(drop=True)
        n_after = len(df_clean)
        dropped = n_before - n_after
        self.log_write(f"Rows before: {n_before}, after cleaning: {n_after}, dropped: {dropped}")

        if n_after == 0:
            messagebox.showerror("No valid data", "No numeric rows left after cleaning.")
            self.df = None
            self._update_range_labels()
            return

        self.df = df_clean.copy()
        messagebox.showinfo("Loaded", f"Loaded and cleaned ({n_after} rows kept, {dropped} dropped).")
        self.log_write(f"Loaded: {FILE_PATH} (rows kept={n_after})")

        # update range labels (preset ranges will still override where set)
        self._update_range_labels()

    def start_training(self):
        if self.df is None:
            messagebox.showwarning("No data", "Please load dataset first.")
            return
        t = threading.Thread(target=self._train_models_thread, daemon=True)
        t.start()

    def _train_models_thread(self):
        """Train all models. Works in background thread and logs errors."""
        try:
            self.log_write("Starting training...")
            X = self.df[FEATURES].values
            y = self.df[TARGET].values
            X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.15, random_state=42)

            pipes = build_pipelines()
            mode = self.mode_var.get()
            n_iter = int(self.iter_spin.get())
            cv = int(self.cv_spin.get())

            self.trained_models = {}
            self.log_write("Models trained will be used for manual predictions. R² values (if shown) are for info only.")

            for name, pipe in pipes.items():
                self.log_write(f"Training {name} ... (mode={mode})")
                est = None

                if mode == "tune":
                    param_dist = PARAM_DIST.get(name, {})
                    if param_dist:
                        try:
                            rs = RandomizedSearchCV(pipe, param_distributions=param_dist,
                                                    n_iter=max(5, n_iter), cv=max(2, cv),
                                                    n_jobs=1, scoring="r2", random_state=0, verbose=0)
                            rs.fit(X_train, y_train)
                            est = rs.best_estimator_
                            params_safe = {k.replace("est__", ""): (v if not hasattr(v, "tolist") else v.tolist())
                                           for k, v in rs.best_params_.items()}
                            self.log_write(f"  Best params: {params_safe}")
                        except Exception as e:
                            self.log_write(f"  Tuning failed for {name}: {e}. Falling back to .fit()")
                            try:
                                pipe.fit(X_train, y_train)
                                est = pipe
                            except Exception as e2:
                                self.log_write(f"  Fallback fit failed for {name}: {e2}. Skipping.")
                                continue
                    else:
                        try:
                            pipe.fit(X_train, y_train)
                            est = pipe
                        except Exception as e:
                            self.log_write(f"  Fit failed for {name}: {e}. Skipping.")
                            continue
                else:
                    try:
                        pipe.fit(X_train, y_train)
                        est = pipe
                    except Exception as e:
                        self.log_write(f"  Fit failed for {name}: {e}. Skipping.")
                        continue

                # Evaluate but do NOT use R² to pick best
                try:
                    r2 = est.score(X_test, y_test)
                    self.log_write(f"  (Info) Test R² ({name}): {r2:.4f}")
                except Exception as e:
                    self.log_write(f"  Scoring failed for {name}: {e}")

                self.trained_models[name] = est

            if not self.trained_models:
                self.log_write("No models successfully trained.")
                messagebox.showwarning("Training", "No models trained successfully.")
                return

            self.log_write("Training finished. Use 'Predict (All models)' to see each model's prediction for your manual input.")
            messagebox.showinfo("Training finished", f"Training finished. {len(self.trained_models)} models ready.")
        except Exception as e:
            self.log_write(f"Training aborted: {e}")
            messagebox.showerror("Training error", str(e))

    def _clean_manual_value(self, raw: str):
        v_clean = re.sub(r"[^0-9eE\+\-\.]", "", raw)
        if v_clean == "":
            raise ValueError(f"Invalid numeric input: {raw!r}")
        return float(v_clean)

    def predict_all_models(self):
        """
        Predict CS for the manual input using all trained models.
        - Warns if any manual input is outside training range for that feature.
        - For each model: logs raw prediction and clamped prediction within observed CS range.
        - Selects model with maximum *clamped* prediction as 'selected (max)'.
        - Also displays mean and median of clamped predictions.
        """
        if not self.trained_models:
            messagebox.showwarning("Not trained", "No trained models found. Please Train first.")
            return

        # collect manual input
        try:
            vals = []
            out_of_range = []
            for feat in FEATURES:
                raw = self.entries[feat].get().strip()
                if raw == "":
                    raise ValueError(f"Empty value for {feat}")
                val = self._clean_manual_value(raw)
                vals.append(val)

                # check against training range if df available and preset not forcing display
                if self.df is not None and feat in self.df.columns:
                    col_min = float(self.df[feat].min())
                    col_max = float(self.df[feat].max())
                    # Use preset for display only; for out-of-range warning we compare to actual df range
                    if val < col_min or val > col_max:
                        out_of_range.append((feat, val, col_min, col_max))
        except Exception as e:
            messagebox.showerror("Input error", str(e))
            return

        # show warning if any feature out of training range
        if out_of_range:
            msg_lines = ["Warning: manual input outside training range:"]
            for feat, v, mn, mx in out_of_range:
                msg_lines.append(f"  {feat}: {v}  (train range: {mn} — {mx})")
            msg_lines.append("Predictions may be unreliable or strongly extrapolated.")
            for L in msg_lines:
                self.log_write(L)
            # show popup with first few lines
            messagebox.showwarning("Out of training range", "\n".join(msg_lines[:10]))

        arr = np.array(vals).reshape(1, -1)

        # compute observed CS range for clamping
        cs_min = float(self.df[TARGET].min()) if (self.df is not None and TARGET in self.df.columns) else None
        cs_max = float(self.df[TARGET].max()) if (self.df is not None and TARGET in self.df.columns) else None
        if cs_min is None or cs_max is None:
            cs_min, cs_max = None, None

        raw_preds = {}
        clamped_preds = {}

        for name, est in self.trained_models.items():
            try:
                p_raw = float(est.predict(arr)[0])
                raw_preds[name] = p_raw
                if cs_min is not None and cs_max is not None:
                    p_clamped = min(max(p_raw, cs_min), cs_max)
                else:
                    p_clamped = p_raw
                clamped_preds[name] = p_clamped
                self.log_write(f"{name}: raw = {p_raw:.4f} MPa; clamped = {p_clamped:.4f} MPa")
            except Exception as e:
                self.log_write(f"Prediction failed for {name}: {e}")

        if not clamped_preds:
            messagebox.showerror("Prediction error", "All model predictions failed.")
            return

        # pick model with maximum clamped predicted CS
        best_name = max(clamped_preds, key=clamped_preds.get)
        best_val = clamped_preds[best_name]

        # aggregate stats
        clamped_values = np.array(list(clamped_preds.values()))
        mean_val = float(np.mean(clamped_values))
        median_val = float(np.median(clamped_values))

        # Update UI
        self.best_model_var.set(best_name)
        self.pred_var.set(f"{best_val:.3f} MPa ({best_name})")
        self.log_write(f"Selected (max clamped) model: {best_name} with predicted CS = {best_val:.4f} MPa")
        self.log_write(f"Aggregate (clamped) -> mean: {mean_val:.4f} MPa; median: {median_val:.4f} MPa")


